# Database Settings
MONGO_URL=mongodb://localhost:27017
DB_NAME=nirogpath
USE_MOCK_DB=false

# Security & JWT Secret
JWT_SECRET=nirogpath-dev-secret-change-in-production-64chars-abcdef0123456789

# ==============================================================================
# AI & Medical RAG (Retrieval-Augmented Generation) API Settings
# ==============================================================================
# The system works 100% out-of-the-box using the built-in grounded RAG engine
# with zero external dependencies. You can optionally connect to external LLMs:

# 1. Google Gemini API (Recommended for live LLM generation)
GEMINI_API_KEY=AQ.Ab8RN6KH4hqfRU9oG4OYrMRiT_OJJD69BUC6Snx7tgoDesP62w
GEMINI_MODEL=gemini-1.5-flash

# 2. OpenAI API
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 3. Custom / Local OpenAI-Compatible LLM (Ollama, Groq, DeepSeek, LocalAI)
